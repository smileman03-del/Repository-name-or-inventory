function renderAdminList(b) {
  b.innerHTML = "";
  b.appendChild(el('<div class="btn p" data-a="newitem">＋ 새 항목 추가</div>'));
  if (S.msg) b.appendChild(el('<div style="font-size:12.5px;font-weight:600;color:var(--acc);margin-top:12px">' + esc(S.msg) + "</div>"));
  var q = S.aq.trim().toLowerCase();
  var res = CAT.filter(function (i) { return !q || (i.n + " " + i.e + " " + i.c + " " + i.g).toLowerCase().indexOf(q) >= 0; }).slice(0, 80);
  b.appendChild(el('<div style="font-size:11.5px;color:var(--dim);margin:16px 0 10px">' + res.length + "개 표시 · 전체 " + CAT.length + "개</div>"));
  var list = el('<div class="list"></div>');
  res.forEach(function (i) {
    list.appendChild(el('<div class="card row" data-a="edititem" data-v="' + esc(i.c) + '">' +
      '<div class="grow"><div class="name">' + esc(i.n) + '</div><div class="meta">' + esc([i.s, i.g, i.c].filter(Boolean).join("  ·  ")) + "</div></div>" +
      '<div class="amt" style="font-size:14px">' + won(i.p) + '</div>' +
      '<div style="color:var(--dim);font-size:18px">›</div></div>'));
  });
  b.appendChild(list);
}

function fieldRow(label, key, ph) {
  var w = el('<div style="margin-top:10px"><div style="font-size:11.5px;font-weight:600;color:var(--mut);margin-bottom:5px">' + label + "</div></div>");
  var i = el('<input data-f="' + key + '" placeholder="' + esc(ph || "") + '" value="' + esc(S.form[key] == null ? "" : S.form[key]) + '">');
  i.addEventListener("input", function (e) { S.form[key] = e.target.value; });
  w.appendChild(i);
  return w;
}

function itemFormView() {
  var v = el('<div id="app"><div class="hd"></div><div class="bd"></div></div>');
  var h = v.querySelector(".hd"), b = v.querySelector(".bd");
  var isNew = !S.form.orig;
  h.appendChild(el('<div class="row"><div class="grow link" data-a="admin">← 목록</div><div style="font-size:13px;font-weight:600;color:var(--mut)">' + (isNew ? "새 항목" : "항목 수정") + "</div></div>"));
  var f = el('<div class="card"></div>');
  var secw = el('<div style="margin-top:2px"><div style="font-size:11.5px;font-weight:600;color:var(--mut);margin-bottom:6px">구분</div><div class="tabs" style="margin-top:0"></div></div>');
  var st = secw.querySelector(".tabs");
  ["행위료", "치료재료대", "약제"].forEach(function (t) {
    st.appendChild(el('<div class="tab ' + (S.form.s === t ? "on" : "") + '" data-a="fsec" data-v="' + t + '">' + t + "</div>"));
  });
  f.appendChild(secw);
  f.appendChild(fieldRow("항목명", "n", "예: 하큐어패치"));
  f.appendChild(fieldRow("중분류", "g", "예: 창상피복제"));
  f.appendChild(fieldRow("영문/규격", "e", "예: 67x34mm"));
  f.appendChild(fieldRow("관리코드 (필수 · 중복 불가)", "c", "예: XBM5001GI"));
  f.appendChild(fieldRow("수가코드", "code2", "예: BM5001GI"));
  f.appendChild(fieldRow("단가 (원)", "p", "90000"));
  f.appendChild(fieldRow("최저비용 (선택)", "lo", "범위 항목만"));
  f.appendChild(fieldRow("최고비용 (선택)", "hi", "범위 항목만"));
  f.appendChild(fieldRow("비고", "note", ""));
  b.appendChild(f);
  if (S.msg) b.appendChild(el('<div style="font-size:12.5px;font-weight:600;color:#a5382e;margin-top:12px">' + esc(S.msg) + "</div>"));
  b.appendChild(el('<div class="btn d" style="margin-top:14px" data-a="saveitem">' + (isNew ? "추가" : "저장") + "</div>"));
  if (!isNew) b.appendChild(el('<div class="btn g" style="margin-top:9px;color:#a5382e" data-a="delitem">이 항목 삭제</div>'));
  b.appendChild(el('<div style="font-size:11.5px;color:var(--dim);margin-top:14px;line-height:1.6">관리코드를 바꾸면 기존 세트에서 그 항목이 빠집니다. 가격만 바뀔 때는 단가만 수정하세요.</div>'));
  return v;
}

/* ---------- actions ---------- */
function claimLines() {
  return picked().map(function (c) { var i = item(c); return { code: i.c, name: i.n, qty: S.qty[c], unit: unit(i) }; });
}
var actions = {
  home: function () { S.screen = "home"; S.edit = false; S.msg = ""; },
  admin: function () {
    if (!S.pin) {
      var p = prompt("관리자 PIN");
      if (!p) return;
      S.pin = p;
      api("checkPin", { pin: p }).then(function () { S.msg = ""; S.screen = "admin"; render(); })
        .catch(function (e) { S.pin = ""; alert("PIN 확인 실패: " + e); });
      return;
    }
    S.msg = ""; S.aq = S.aq || ""; S.screen = "admin";
  },
  newitem: function () {
    S.form = { s: "치료재료대", g: "", n: "", e: "", c: "", code2: "", p: "", lo: "", hi: "", note: "", orig: "" };
    S.msg = ""; S.screen = "itemform";
  },
  edititem: function (v) {
    var i = item(v); if (!i) return;
    S.form = { s: i.s, g: i.g, n: i.n, e: i.e, c: i.c, code2: i.code2 || "", p: i.p, lo: i.lo || "", hi: i.hi || "", note: i.note || "", orig: i.c };
    S.msg = ""; S.screen = "itemform";
  },
  fsec: function (v) { S.form.s = v; },
  saveitem: function () {
    var f = S.form;
    if (!f.n || !String(f.n).trim()) { S.msg = "항목명을 입력하세요."; return; }
    if (!f.c || !String(f.c).trim()) { S.msg = "관리코드를 입력하세요."; return; }
    var p = Object.assign({}, f, { pin: S.pin, p: Number(String(f.p).replace(/[^\d]/g, "")) || 0,
      lo: Number(String(f.lo).replace(/[^\d]/g, "")) || 0, hi: Number(String(f.hi).replace(/[^\d]/g, "")) || 0 });
    S.msg = "저장 중...";
    api(f.orig ? "updateItem" : "addItem", p).then(function () {
      S.msg = f.orig ? "수정되었습니다." : "추가되었습니다.";
      S.screen = "admin"; sync();
    }).catch(function (e) { S.msg = "실패: " + e; render(); });
  },
  delitem: function () {
    if (!confirm('"' + S.form.n + '" 항목을 단가표에서 삭제할까요?')) return;
    S.msg = "삭제 중...";
    api("deleteItem", { pin: S.pin, c: S.form.orig }).then(function () {
      S.msg = "삭제되었습니다."; S.screen = "admin"; sync();
    }).catch(function (e) { S.msg = "실패: " + e; render(); });
  },
  edit: function () { S.edit = !S.edit; },
  newset: function () {
    var n = prompt("새 세트 이름 (예: 어깨 회전근개 봉합술)");
    if (!n) return;
    S.title = n.trim(); S.list = []; S.base = []; S.qty = {}; S.amt = {}; S.q = ""; S.edit = false; S.screen = "catalog";
  },
  delset: function (v, t) {
    var s = SETS[+t.getAttribute("data-i")];
    if (!confirm('"' + s.name + '" 세트를 삭제할까요?')) return;
    SETS = SETS.filter(function (x) { return x.name !== s.name; });
    localStorage.setItem("bg_sets", JSON.stringify(SETS));
    api("deleteSet", { name: s.name }).then(sync).catch(function () {});
  },
  remove: function (v) {
    S.list = S.list.filter(function (c) { return c !== v; });
    S.base = S.base.filter(function (c) { return c !== v; });
    delete S.qty[v]; delete S.amt[v];
  },
  list: function () { S.screen = "list"; },
  catalog: function () { S.q = ""; S.screen = "catalog"; },
  review: function () { S.screen = "review"; },
  claim: function () { S.msg = ""; S.screen = "claim"; },
  explain: function () { S.screen = "explain"; },
  sync: function () { sync(); },

  open: function (v, t) { openSet(SETS[+t.getAttribute("data-i")]); },
  tab: function (v) { S.tab = v; },
  toggle: function (v) { S.qty[v] = S.qty[v] > 0 ? 0 : 1; },
  inc: function (v) { S.qty[v] = (S.qty[v] || 0) + 1; },
  dec: function (v) { S.qty[v] = Math.max(0, (S.qty[v] || 0) - 1); },
  use: function (v) { S.qty[v] = 1; },
  skip: function (v) { S.base = S.base.filter(function (c) { return c !== v; }); },
  add: function (v) {
    if (S.list.indexOf(v) < 0) S.list.push(v);
    S.qty[v] = S.qty[v] > 0 ? 0 : 1;
    if (!S.title) S.title = "새 체크리스트";
  },
  copy: function () {
    var t = claimLines().map(function (l) { return [l.code, l.name, l.qty, l.unit * l.qty].join("\t"); }).join("\n") + "\n합계\t\t\t" + total();
    if (navigator.clipboard) navigator.clipboard.writeText(t);
    S.msg = "청구 목록을 복사했습니다.";
  },
  save: function () {
    S.msg = "기록 중...";
    api("saveCase", { setName: S.title, patient: S.patient, staff: S.staff, lines: claimLines() })
      .then(function (d) { S.msg = "구글 시트에 " + d.saved + "행 기록됨."; render(); })
      .catch(function (e) { S.msg = "기록 실패: " + e; render(); });
  },
  saveset: function () {
    S.msg = "저장 중...";
    api("saveSet", { name: S.title, note: "사용 기록", codes: picked() })
      .then(function () { S.msg = "세트를 저장했습니다."; sync(); })
      .catch(function (e) { S.msg = "저장 실패: " + e; render(); });
  }
};

document.addEventListener("click", function (ev) {
  var t = ev.target.closest("[data-a]"); if (!t) return;
  var a = t.getAttribute("data-a"), v = t.getAttribute("data-v");
  if (!actions[a]) return;
  actions[a](v, t);
  render();
});
document.addEventListener("input", function (ev) {
  var t = ev.target.closest('[data-a="amt"]'); if (!t) return;
  S.amt[t.getAttribute("data-v")] = t.value.replace(/[^\d]/g, "");
});
document.addEventListener("change", function (ev) {
  if (ev.target.closest('[data-a="amt"]')) render();
});

var lastScreen = null;
function render() {
  var views = { home: homeView, list: listView, catalog: catalogView, review: reviewView, claim: claimView, admin: adminView, itemform: itemFormView, explain: explainView };
  var next = views[S.screen]();
  var cur = document.getElementById("app");
  var sameScreen = S.screen === lastScreen;
  var scroll = (sameScreen && cur && cur.querySelector(".bd")) ? cur.querySelector(".bd").scrollTop : 0;
  cur.replaceWith(next);
  if (sameScreen && next.querySelector(".bd")) next.querySelector(".bd").scrollTop = scroll;
  lastScreen = S.screen;
}
render();
sync();
</script>

<script id="sx-enhancements-js">
(function(){
  // 스크롤 위치 고정
  function patchRR(){
    if(typeof renderResults==='function'&&!window._sxRROrig){
      window._sxRROrig=renderResults;
      window.renderResults=function(){
        var bd=document.querySelector('.bd');
        var saved=bd?bd.scrollTop:0;
        window._sxRROrig.apply(this,arguments);
        requestAnimationFrame(function(){
          var nb=document.querySelector('.bd');
          if(nb) nb.scrollTop=saved;
        });
      };
    }
  }
  patchRR();
  document.addEventListener('DOMContentLoaded',patchRR);
  setTimeout(patchRR,300); setTimeout(patchRR,800);

  // 수술 세트 배지
  function badge(){
    var hd=document.querySelector('#app .hd');
    if(!hd||document.getElementById('sx-badge')) return;
    var tEl=hd.querySelector('.grow');
    if(!tEl||tEl.textContent.trim()!=='항목 추가') return;
    var nm=window.S&&window.S.title;
    if(!nm) return;
    var b=document.createElement('div');
    b.id='sx-badge';
    b.innerHTML='<span style="color:#6B7280;font-size:12px;font-weight:500">수술 세트<\/span>'
      +'<span style="font-weight:700;color:#1D4ED8;font-size:15px;margin-left:4px">▸ '+nm+'<\/span>';
    var inp=hd.querySelector('input');
    hd.insertBefore(b,inp);
  }
  var obs=new MutationObserver(function(){
    clearTimeout(window._sxBT);
    window._sxBT=setTimeout(badge,50);
  });
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',function(){ obs.observe(document.body,{childList:true,subtree:true}); });
  } else {
    obs.observe(document.body,{childList:true,subtree:true});
  }
  badge();
})();
<\/script>
</body></html>
