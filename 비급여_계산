function sync() {
  api("all").then(function (d) {
    if (d.catalog && d.catalog.length) { CAT = d.catalog; localStorage.setItem("bg_cat", JSON.stringify(CAT)); }
    if (d.sets) { SETS = d.sets; localStorage.setItem("bg_sets", JSON.stringify(SETS)); }
    S.online = true; S.dup = checkDupCodes(); render();
  }).catch(function () { S.online = false; S.dup = checkDupCodes(); render(); });
}

function won(n) { return "₩" + Math.round(n || 0).toLocaleString("ko-KR"); }
function item(c) { for (var i = 0; i < CAT.length; i++) if (CAT[i].c === c) return CAT[i]; return null; }
function unit(i) { var v = S.amt[i.c]; return (v === undefined || v === "" || isNaN(+v)) ? i.p : +v; }
function picked() { return S.list.filter(function (c) { return S.qty[c] > 0; }); }
function total() { return picked().reduce(function (a, c) { var i = item(c); return a + (i ? unit(i) * S.qty[c] : 0); }, 0); }
function esc(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (m) { return ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" })[m]; }); }
function el(html) { var d = document.createElement("div"); d.innerHTML = html; return d.firstElementChild; }

function openSet(s) {
  S.title = s.name; S.list = s.codes.slice(); S.base = s.codes.slice();
  S.qty = {}; s.codes.forEach(function (c) { S.qty[c] = 1; });
  S.amt = {}; S.tab = "전체"; S.msg = ""; S.screen = "list"; render();
}

