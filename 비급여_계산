function renderResults(b) {
  b.innerHTML = "";
  var q = S.q.trim().toLowerCase();
  var res = CAT.filter(function (i) { return S.tab === "전체" || i.s === S.tab; })
    .filter(function (i) { return !q || (i.n + " " + i.e + " " + i.c + " " + i.g).toLowerCase().indexOf(q) >= 0; })
    .slice(0, 80);
  b.appendChild(el('<div style="font-size:11.5px;color:var(--dim);margin-bottom:10px">' + res.length + "개 결과</div>"));
  var list = el('<div class="list"></div>');
  res.forEach(function (i) {
    var on = S.qty[i.c] > 0;
    list.appendChild(el('<div class="card row" data-a="add" data-v="' + i.c + '">' +
      '<div class="grow"><div class="name">' + esc(i.n) + '</div><div class="meta">' + esc([i.g, i.e, i.c].filter(Boolean).join("  ·  ")) + "</div></div>" +
      '<div class="amt" style="font-size:14px;text-align:right">' + ((i.lo && i.hi) ? won(i.lo) + "–" + won(i.hi) : won(i.p)) + "</div>" +
      '<div class="box ' + (on ? "on" : "") + '" style="border-radius:8px">' + (on ? "✓" : "") + "</div></div>"));
  });
  b.appendChild(list);
}

