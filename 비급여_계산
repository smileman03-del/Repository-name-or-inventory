/* ── 커서: 클릭 가능 요소 전체 ── */
[data-a], .link, .btn, .dash, .tab, .mini, .stp span { cursor: pointer; user-select: none; }
input, textarea { cursor: text; user-select: auto; }

/* ── .link (텍스트 링크) 호버 ── */
.link:hover { opacity: 0.65; }

/* ── .btn 버튼 호버 ── */
.btn.p:hover { background: #0e5f8a !important; }
.btn.d:hover { filter: brightness(0.88); }
.btn.g:hover { background: rgba(0,0,0,.10) !important; }

/* ── .dash (점선 카드 버튼) 호버 ── */
.dash:hover { background: #EEF2FF; border-color: #93C5FD; color: #1D4ED8; }

/* ── .tab 필터 탭 호버 ── */
.tab:not(.on):hover { background: rgba(0,0,0,.10); color: var(--ink); }

/* ── .mini 버튼 호버 ── */
.mini:hover { opacity: 0.78; }

/* ── 수량 스테퍼 −/+ 호버 ── */
.stp span:hover { background: rgba(0,0,0,.10); border-radius: 4px; padding: 1px 4px; }

/* ── 체크박스(.box) 호버 ── */
.box:not(.on):hover { border-color: var(--acc) !important; }
.box.on:hover { opacity: 0.82; }

/* ── 홈 · 세트 카드 호버 ── */
#app .card.row[data-a="open"]:hover,
#app .card.row[data-a="catalog"]:hover { background: #F0F4FF; }

/* ── 카탈로그(항목추가) 카드 ── */
#app .card.row[data-a="add"]:hover,
#app .card.row[data-a="remove"]:not([data-a="remove"]):hover { background: #F0F4FF !important; }
#app .card.row[data-a="remove"] { background: #F0FDF4 !important; box-shadow: inset 3px 0 0 #22C55E; }
#app .card.row[data-a="remove"]:hover { background: #DCFCE7 !important; }

/* ── 관리자 항목 카드 호버 ── */
#app .card.row[data-a="edititem"]:hover { background: #F5F5FF; }

/* ── listView 카드 안 toggle 영역 호버 ── */
#app .card [data-a="toggle"]:hover { color: var(--acc); }
#app .card [data-a="toggle"] .name:hover { color: var(--acc); }

/* ── reviewView 누락 항목 행 호버 ── */
#app .row[data-a="use"]:hover, #app [data-a="use"]:hover { opacity: 0.82; }
#app [data-a="skip"]:hover { opacity: 0.78; }

/* ── 수술 배지 ── */
#sx-badge {
  display: flex; align-items: center; gap: 8px;
  padding: 9px 16px;
  background: linear-gradient(90deg,#EEF2FF 0%,#F0F9FF 100%);
  border-bottom: 1.5px solid #C7D7FD;
  font-size: 13px;
}
</style></head>
