<style>
:root{--ink:#17191A;--mut:#6E7375;--dim:#9A9FA2;--line:rgba(0,0,0,.07);--acc:#1273a8;--bg:#F5F3EF}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:#D8D5D0;font-family:Pretendard,-apple-system,system-ui,sans-serif;color:var(--ink)}
body{display:flex;justify-content:center;align-items:flex-start}
#app{display:flex;flex-direction:column;height:100dvh;width:100%;max-width:480px;background:var(--bg);box-shadow:0 0 40px rgba(0,0,0,.18)}
.hd{flex:none;padding:calc(env(safe-area-inset-top) + 16px) 18px 12px;border-bottom:1px solid rgba(0,0,0,.06)}
.bd{flex:1;overflow:auto;padding:14px 18px 24px;-webkit-overflow-scrolling:touch}
.ft{flex:none;padding:12px 18px calc(env(safe-area-inset-bottom) + 14px);background:#fff;border-top:1px solid var(--line);display:flex;align-items:center;gap:14px}
.h1{font-size:28px;font-weight:700;letter-spacing:-.03em;line-height:1.2}
.h2{font-size:22px;font-weight:700;letter-spacing:-.02em;line-height:1.25;margin-top:12px}
.sub{font-size:12.5px;color:var(--dim);margin-top:7px}
.link{font-size:15px;font-weight:600;color:var(--acc)}
.card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:14px 15px}
.row{display:flex;align-items:center;gap:12px}
.grow{flex:1;min-width:0}
.name{font-size:14.5px;font-weight:600;letter-spacing:-.01em;line-height:1.35}
.meta{font-size:11.5px;color:var(--dim);margin-top:4px;font-family:ui-monospace,Menlo,monospace;word-break:break-all}
.amt{font-size:14.5px;font-weight:700;font-variant-numeric:tabular-nums}
.tabs{display:flex;gap:6px;margin-top:13px;overflow:auto}
.tab{flex:none;padding:7px 12px;border-radius:9px;background:rgba(0,0,0,.05);color:var(--mut);font-size:12.5px;font-weight:500}
.tab.on{background:var(--ink);color:#fff;font-weight:600}
.box{width:21px;height:21px;border-radius:7px;border:1.5px solid #C9CDCF;flex:none;display:flex;align-items:center;justify-content:center;color:transparent;font-size:12px;font-weight:700}
.box.on{background:var(--acc);border-color:var(--acc);color:#fff}
.stp{display:flex;align-items:center;gap:10px;background:rgba(0,0,0,.045);border-radius:8px;padding:5px 9px;font-weight:600;font-size:13px}
.stp b{min-width:14px;text-align:center;font-variant-numeric:tabular-nums}
.btn{border-radius:12px;padding:14px 18px;font-size:15px;font-weight:600;text-align:center}
.btn.p{background:var(--acc);color:#fff}
.btn.d{background:var(--ink);color:#fff}
.btn.g{background:rgba(0,0,0,.05);color:#3D4245}
.dash{border:1.5px dashed #CFD3D5;border-radius:14px;padding:14px;text-align:center;font-size:14px;font-weight:600;color:var(--mut);margin-top:12px}
